# Broker: "sqlite" (local, default) or "kafka"
BROKER_BACKEND=sqlite
KAFKA_BOOTSTRAP=localhost:9092
NUM_PARTITIONS=4
CONSUMER_GROUP=fraud-scorer

# Decision policy (risk score 0-100)
REVIEW_THRESHOLD=50
DECLINE_THRESHOLD=80

# Micro-batching
BATCH_MAX_EVENTS=2000
FLUSH_MAX_SECONDS=5
CHECKPOINT_EVERY_S=30

# Simulator
SIM_FRAUD_RATE=0.004
SIM_MALFORMED_RATE=0.001

API_URL=http://127.0.0.1:8000
FRAUD_LOG_LEVEL=INFO
